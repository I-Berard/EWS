# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_deformation

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Object Storage Configuration (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=sentinel-raw
S3_BUCKET_INTERMEDIATE=sentinel-intermediate
S3_BUCKET_PRODUCTS=sentinel-products

# Copernicus Data Space Ecosystem Credentials
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# API Configuration
CORS_ORIGINS=["http://localhost:5173"]
API_PORT=8000
